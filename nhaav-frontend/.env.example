# Frontend environment template — copy to `.env.local` (never commit real values).
#
# Backend origin, without a trailing slash. Used for every API call and, at
# BUILD time, for the Content-Security-Policy `connect-src` directive — rebuild
# after changing it or the browser will block API requests.
#
# The API and the app must share a registrable domain (app.example.com +
# api.example.com): the session lives in httpOnly cookies, and a cookie is not
# sent to a completely different site.
# Local development default. A production build must provide the real API
# origin (through the CI/build environment or `.env.production`); omitting it
# keeps the localhost fallback and is not suitable for production.
VITE_API_URL=http://localhost:8000

# Public origin of the deployed site — used for canonical URLs, Open Graph and
# JSON-LD structured data. No trailing slash. Example: https://nhaav.com
VITE_SITE_URL=http://localhost:3000
