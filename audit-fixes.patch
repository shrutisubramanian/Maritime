+    # anonymous caller has neither header nor cookie.
+    client.cookies.clear()
+    res = client.put(f"/documents/{doc.id}/verify")
+    assert res.status_code == 401, f"Expected 401 for anonymous verify, got {res.status_code}: {res.text}"
+
