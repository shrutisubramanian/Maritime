# ─────────────────────────────────────────────────────────────────────────────
# Nhaav backend — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this template is
# committed and must only ever contain PLACEHOLDERS. Never put a real secret in
# this file.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Required core ────────────────────────────────────────────────────────────
# Fail-fast: the app refuses to boot without these.
DATABASE_URL=sqlite:///./nhaav.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ENVIRONMENT must be one of development|staging|production. A missing value is
# treated as production (fail-closed). Development is the only environment that
# enables the development-only provisioning endpoints and the console email
# backend.
ENVIRONMENT=development

# Public origin of the frontend. Used to build the links inside emails, so it
# must match the deployed frontend exactly (no trailing slash).
FRONTEND_URL=http://localhost:5173

# Address that receives in-app support tickets and general queries.
SUPPORT_EMAIL=nhaavnotifications@gmail.com

# ── Transactional email ──────────────────────────────────────────────────────
# EMAIL_BACKEND selects the transport:
#   smtp    - real delivery over SMTP (required outside local development)
#   console - logs a one-line summary and sends nothing (development only;
#             production refuses to boot with it)
# Defaults to `console` in development and `smtp` everywhere else.
EMAIL_BACKEND=smtp

# Every email setting can be given under its SMTP_* name or its EMAIL_* name.
# SMTP_* is the vendor-neutral spelling from the brief; the EMAIL_* names are the
# long-standing ones and keep existing deployments working. If BOTH are present
# the EMAIL_* name wins, including when it is empty — blanking a variable is
# treated as a misconfiguration the fail-fast should report, never as a cue to
# fall back to the other spelling.
#
#   SMTP_HOST (EMAIL_HOST)                  SMTP_PORT (EMAIL_PORT)
#   SMTP_USERNAME (EMAIL_HOST_USER)         SMTP_PASSWORD (EMAIL_HOST_PASSWORD)
#   SMTP_FROM_EMAIL (EMAIL_FROM)            SMTP_FROM_NAME (EMAIL_FROM_NAME)
#   SMTP_USE_TLS (EMAIL_USE_TLS)            SMTP_BACKEND (EMAIL_BACKEND)
#   SMTP_TIMEOUT_SECONDS (EMAIL_TIMEOUT_SECONDS)

# ── Gmail (reference SMTP configuration) ─────────────────────────────────────
# Requires 2-Step Verification on the Google account, then an App Password
# created at https://myaccount.google.com/apppasswords — a normal account
# password is rejected by Gmail's SMTP.
#
# Paste the App Password WITHOUT the spaces Google displays it with.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=nhaavnotifications@gmail.com
SMTP_PASSWORD=your-16-character-app-password
# Gmail rewrites or rejects a From address that is not the authenticated account
# (or a verified alias), so use the same address here.
SMTP_FROM_EMAIL=nhaavnotifications@gmail.com
# Display name recipients see. Keep it consistent with the brand in the emails.
SMTP_FROM_NAME=Nhaav
# STARTTLS on 587 with full certificate validation.
SMTP_USE_TLS=true
# Bounded socket timeout, so a slow mail server cannot hold a request thread.
SMTP_TIMEOUT_SECONDS=10

# ── Other providers (same variables, different values) ───────────────────────
# Resend   : SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USERNAME=resend
#            SMTP_PASSWORD=<API key>    SMTP_FROM_EMAIL=no-reply@yourdomain.com
# SendGrid : SMTP_HOST=smtp.sendgrid.net SMTP_PORT=587 SMTP_USERNAME=apikey
#            SMTP_PASSWORD=<API key>
# Amazon SES: SMTP_HOST=email-smtp.<region>.amazonaws.com SMTP_PORT=587
#            (SMTP_USERNAME/PASSWORD are the SES SMTP credentials)

# ── Optional: access gating / payments ──────────────────────────────────────
# Offline bank-transfer details shown to clients. Deliberately empty by default:
# no bank details are hardcoded in source. The API reports configured=false
# until an operator supplies these.
# PAYMENT_BANK_ACCOUNT_HOLDER=
# PAYMENT_BANK_NAME=
# PAYMENT_BANK_ACCOUNT_NUMBER=
# PAYMENT_BANK_IFSC=
# PAYMENT_BANK_BRANCH=
# PAYMENT_BANK_ACCOUNT_TYPE=
# PAYMENT_INSTRUCTIONS=
# PAYMENT_CURRENCY=INR
# GST charged ON TOP of a plan's listed price. 18% turns ₹1,000 into ₹1,180 and
# ₹10,000 into ₹11,800. Change this only with a tax decision; stored payments
# keep the total they were charged at.
# GST_RATE_PERCENT=18

# ── Optional: CORS ──────────────────────────────────────────────────────────
# Comma-separated allowlist. A wildcard is refused in production.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Browser session cookies ─────────────────────────────────────────────────
# The browser signs in with httpOnly cookies (`nhaav_access`,
# `nhaav_refresh`) plus a readable CSRF cookie (`nhaav_csrf`) that the app
# copies into `X-CSRF-Token`. No token is stored in JavaScript. Three
# deployment consequences:
#   * The API and the app must share a registrable domain (app.example.com +
#     api.example.com). A completely different site cannot receive the cookies.
#   * CORS_ORIGINS must list the exact app origin; credentialed requests from
#     any other origin are refused.
#   * Cookies are SameSite=Lax and Secure outside development, so the API must
#     be served over HTTPS in production.

# ── First admin account (used by `python -m app.seed_admin`) ────────────────
# Required outside development. Never commit real values; this file is a
# template only.
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=use-a-long-random-password
# ADMIN_NAME=Nhaav Admin
# Sign-in name for the admin console (it asks for a USERNAME, not an email).
# Optional: without it the console falls back to signing in with ADMIN_EMAIL.
# ADMIN_USERNAME=backoffice-admin

# ── Optional: auth brute-force budgets (per 15-minute window) ───────────────
# Two buckets per endpoint: FAILURES charged to the attempted account, and ALL
# ATTEMPTS charged to the source network. A correct password is never blocked
# by the per-account failure budget.
# AUTH_LOGIN_FAILED_PER_EMAIL_LIMIT=5
# AUTH_LOGIN_PER_IP_LIMIT=60
# AUTH_ADMIN_LOGIN_FAILED_PER_EMAIL_LIMIT=5
# AUTH_ADMIN_LOGIN_PER_IP_LIMIT=20
# AUTH_FORGOT_PER_EMAIL_LIMIT=3
# AUTH_FORGOT_PER_IP_LIMIT=10
# AUTH_RESEND_PER_EMAIL_LIMIT=3
# AUTH_RESEND_PER_IP_LIMIT=10
#
# Source IP for those per-network budgets. FALSE by default: when the API is
# directly reachable, X-Forwarded-For/X-Real-IP are attacker-controlled and must
# be ignored. Set TRUE only after confirming the API is behind a reverse proxy
# that overwrites the header. Optionally restrict trust to the proxy addresses
# with TRUSTED_PROXIES (comma-separated IPs/CIDRs).
# TRUST_PROXY_HEADERS=false
# TRUSTED_PROXIES=

# ── Optional: JWT signing algorithm ────────────────────────────────────────
# Symmetric only (HS256 | HS384 | HS512); anything else refuses to boot. Use a
# secret of at least 32 random characters in production (`openssl rand -hex 32`).
# JWT_ALGORITHM=HS256

# ── Session cookies and admin access tokens ────────────────────────────────
# Secure cookies are required on every HTTPS deployment. Defaults to true in
# staging/production and false in local development.
# COOKIE_SECURE=false
# Admin access tokens are short-lived and bound to the refresh-session id, so
# logout/password reset revoke them immediately.
# ADMIN_JWT_EXPIRE_MINUTES=30
# Browser responses omit tokens by default. Only enable for a non-browser API
# client; never for a browser deployment.
# EXPOSE_SESSION_TOKENS=false

# ------------------------------------------------ manual pass issue (exception)
# Production rule: a client's passes follow a VERIFIED platform payment — the
# admin approving the fee issues 10 (monthly) or 100 (annual) automatically.
# Manual issue is a no-payment exception and is DISABLED unless set to true.
# When enabled, the admin panel demands a written reason and an explicit
# no-payment confirmation, and both are recorded in the audit trail.
# ALLOW_MANUAL_PASS_GRANTS=false
